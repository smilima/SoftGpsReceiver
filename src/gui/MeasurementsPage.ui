<ui version="4.0">
 <class>MeasurementsPage</class>
 <widget class="QWidget" name="MeasurementsPage">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1400</width><height>1000</height></rect>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <item>
    <layout class="QHBoxLayout" name="controlsLayout">
     <item><widget class="QLabel" name="epochLabel"><property name="text"><string>Epoch</string></property></widget></item>
     <item><widget class="QSlider" name="epochSlider"><property name="orientation"><enum>Qt::Horizontal</enum></property></widget></item>
     <item><widget class="QSpinBox" name="epochSpin"/></item>
