       <item row="1" column="0">
        <widget class="gui::PlotWidget" name="dopplerPlot" native="true">
         <property name="title" stdset="0"><string>Doppler: measured, common front-end offset removed (lines) vs predicted from orbits + velocity (points)</string></property>
         <property name="xLabel" stdset="0"><string>GPS time of week (s)</string></property>
         <property name="yLabel" stdset="0"><string>Hz</string></property>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="gui::PlotWidget" name="tropoPlot" native="true">
