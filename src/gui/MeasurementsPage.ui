      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QSplitter" name="splitter">
     <property name="orientation"><enum>Qt::Vertical</enum></property>
     <widget class="QGroupBox" name="obsGroup">
      <property name="title"><string>Observations and corrections at the selected epoch:  corrected PR = raw PR + c*dt_sv - iono - tropo;  residual = corrected PR - |r_sat - r_rx| - b</string></property>
      <layout class="QVBoxLayout" name="obsLayout">
       <item><widget class="gui::DataTable" name="obsTable"/></item>
      </layout>
     </widget>
     <widget class="QWidget" name="plotsWidget">
      <layout class="QGridLayout" name="plotsGrid">
       <item row="0" column="0">
        <widget class="gui::PlotWidget" name="prPlot" native="true">
         <property name="title" stdset="0"><string>Raw pseudorange change since first epoch</string></property>
         <property name="xLabel" stdset="0"><string>GPS time of week (s)</string></property>
         <property name="yLabel" stdset="0"><string>m</string></property>
        </widget>
       </item>
       <item row="0" column="1">
        <widget class="gui::PlotWidget" name="residualPlot" native="true">
         <property name="title" stdset="0"><string>Post-fit pseudorange residuals</string></property>
         <property name="xLabel" stdset="0"><string>GPS time of week (s)</string></property>
         <property name="yLabel" stdset="0"><string>m</string></property>
        </widget>
       </item>
       <item row="0" column="2">
        <widget class="gui::PlotWidget" name="cmcPlot" native="true">
         <property name="title" stdset="0"><string>Code minus carrier (relative to first epoch, common mode removed)</string></property>
         <property name="xLabel" stdset="0"><string>GPS time of week (s)</string></property>
         <property name="yLabel" stdset="0"><string>m</string></property>
