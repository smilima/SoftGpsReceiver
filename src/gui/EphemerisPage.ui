      <layout class="QVBoxLayout" name="almLayout">
       <item><widget class="QLabel" name="almInfoLabel"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>Almanac pages (subframe 5 pages 1-24, subframe 4 pages 2-5 and 7-10) decoded from any tracked satellite. A complete almanac takes 12.5 minutes; a short recording contains only a few pages.</string></property></widget></item>
       <item><widget class="gui::DataTable" name="almTable"/></item>
