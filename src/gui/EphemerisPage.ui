      <layout class="QVBoxLayout" name="healthLayout">
       <item><widget class="QLabel" name="healthInfoLabel"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>Satellite health from three sources: the 6-bit health in subframe 1 (own ephemeris), the 8-bit almanac health, and the 6-bit health summaries of subframe 5 page 25 / subframe 4 page 25, plus the anti-spoofing flag and SV configuration code.</string></property></widget></item>
       <item><widget class="gui::DataTable" name="healthTable"/></item>
      </layout>
