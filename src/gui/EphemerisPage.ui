      <layout class="QVBoxLayout" name="ephLayout">
       <item><widget class="QLabel" name="ephInfoLabel"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>Broadcast ephemeris and clock parameters for every tracked satellite, in ICD units and converted to SI units, with derived orbit quantities.</string></property></widget></item>
